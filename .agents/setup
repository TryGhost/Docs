#!/usr/bin/env bash
# Prepares an Amp orb for this repository. Amp runs it for fresh orbs and again
# on top of older project snapshots, so every step must be safe to repeat.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

timed() {
	local label=$1 start=$SECONDS
	shift
	echo "==> $label"
	"$@"
	echo "    $label took $((SECONDS - start))s"
}

# Mintlify supports only some Node.js releases, so the orb runs the version
# pinned in .nvmrc instead of the one that comes with the orb image. It replaces
# the image's Node.js in /usr/local so every shell and service finds it.
install_node() {
	local version arch tarball tmp
	version=$(<.nvmrc)
	if [[ "$(node --version 2>/dev/null)" == "v$version" ]]; then
		echo "    Node.js v$version is already installed"
		return
	fi
	case "$(uname -m)" in
	x86_64) arch=x64 ;;
	aarch64) arch=arm64 ;;
	*)
		echo "unsupported architecture: $(uname -m)" >&2
		return 1
		;;
	esac
	tarball="node-v$version-linux-$arch.tar.gz"
	tmp=$(mktemp -d)
	curl -fsSL -o "$tmp/$tarball" "https://nodejs.org/dist/v$version/$tarball"
	curl -fsSL "https://nodejs.org/dist/v$version/SHASUMS256.txt" | grep " $tarball\$" | (cd "$tmp" && sha256sum --check --quiet -)
	sudo rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack /usr/local/include/node
	sudo tar -xzf "$tmp/$tarball" -C /usr/local --strip-components=1 --no-same-owner \
		"node-v$version-linux-$arch/"{bin,include,lib,share}
	rm -rf "$tmp"
	if [[ "$(node --version)" != "v$version" ]]; then
		echo "another Node.js comes first on PATH: $(command -v node)" >&2
		return 1
	fi
}

# Mintlify commands need a ~250 MB preview client in ~/.mintlify. `mint validate`
# downloads it to the shared location that `mint dev` copies from, so the first
# preview or check in an orb skips the download. Validation findings in the docs
# must not fail setup; a CLI that cannot start or a missing client must.
warm_mintlify_client() {
	local versions
	if ! CI=1 pnpm exec mint validate --telemetry=false; then
		echo "    mint validate reported problems; continuing because setup only needs the client"
	fi
	versions=$(CI=1 pnpm exec mint version --telemetry=false)
	echo "$versions"
	[[ "$versions" == *"client version "[0-9]* ]]
}

timed "Install Node.js $(<.nvmrc)" install_node

# pnpm comes with the orb image and switches to the version pinned in
# package.json's packageManager field on its own.
echo "Node.js $(node --version), pnpm $(pnpm --version)"

timed "Install dependencies" pnpm install --frozen-lockfile
timed "Download Mintlify preview client" warm_mintlify_client
