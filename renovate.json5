{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    extends: ["local>TryGhost/renovate-config"],
    packageRules: [
        {
            description: "Require manual review for Mint CLI updates because Mint defines documentation validation behavior",
            matchManagers: ["npm"],
            matchPackageNames: ["mint"],
            automerge: false,
        },
        {
            description: "Keep .nvmrc and engines on the newest Node.js LTS release Mintlify supports. CI checks that this limit matches the Mint CLI README",
            matchDatasources: ["node-version"],
            allowedVersions: "<25",
            groupName: "Node.js",
            automerge: true,
        },
    ],
}
